# Lynx Web Solutions — environment template
# Copy to `.env.local`. Never commit secrets.
# SKIP_ENV_VALIDATION=1 only for emergency local bypass.

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43127
NEXT_PUBLIC_WHATSAPP_NUMBER=919999803336

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Lynx Web Solutions <care@lynxweb.in>
EMAIL_TO_TEAM=care@lynxweb.in

# --- Supabase (service role is server-only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cashfree (only payment provider) ---
# Dashboard → Payment Gateway → Developers → API Keys
# Supports India (UPI/cards/netbanking) + international cards when enabled on your Cashfree account.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# --- WhatsApp Cloud API (payment confirmations) ---
# Meta Business Suite → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name with body vars: {{1}} name {{2}} amount {{3}} document {{4}} reference
WHATSAPP_PAYMENT_TEMPLATE=payment_confirmation
WHATSAPP_TEMPLATE_LANG=en
