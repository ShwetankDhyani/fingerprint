# Lynx Web Solutions — environment template
# Copy to `.env.local` and fill values. Never commit secrets.
# Set SKIP_ENV_VALIDATION=1 only for emergency local bypass.

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43127
NEXT_PUBLIC_WHATSAPP_NUMBER=919999803336

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Lynx Web Solutions <care@lynxweb.in>
EMAIL_TO_TEAM=care@lynxweb.in

# --- Supabase (service role is server-only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Razorpay (India rail) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Stripe (global rail) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# --- WhatsApp Cloud API (Meta) — optional until Business account is ready ---
# Without these, automated messages are mocked to server logs.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# --- Admin panel (/admin) ---
# Required in production. In development, a local fallback password is used if unset.
ADMIN_PASSWORD=
