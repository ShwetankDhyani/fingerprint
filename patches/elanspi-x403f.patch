+static int
+elanspi_get_rotation (FpiDeviceElanSpi *self)
+{
+  const gchar *env = g_getenv ("ELANSPI_ROTATE");
+
+  if (env && env[0] != '\0')
+    {
+      int v = g_ascii_strtoll (env, NULL, 10);
+      if (v >= 0 && v <= 3)
+        return v;
+    }
+
+  return fpi_device_get_driver_data (FP_DEVICE (self)) & 3;
+}
