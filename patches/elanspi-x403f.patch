+/* Separable gaussian smoothing (sigma ~1.2). Suppresses sensor-noise speckle
+ * that otherwise produces spurious, non-repeatable image features. */
+static void
+elanspi_smooth_image (FpImage *img)
+{
+  static const guint kern[7] = { 34, 111, 218, 298, 218, 111, 34 };
+  guint w = img->width, h = img->height;
+  g_autofree guint8 *tmp = g_malloc (w * h);
+  guint8 *data = (guint8 *) img->data;
+
+  for (guint y = 0; y < h; y++)
+    for (guint x = 0; x < w; x++)
+      {
+        guint acc = 0, wsum = 0;
+        for (gint k = -3; k <= 3; k++)
+          {
+            gint xx = (gint) x + k;
+            if (xx < 0 || xx >= (gint) w)
+              continue;
+            acc += kern[k + 3] * data[y * w + xx];
+            wsum += kern[k + 3];
+          }
+        tmp[y * w + x] = acc / wsum;
+      }
+  for (guint y = 0; y < h; y++)
+    for (guint x = 0; x < w; x++)
+      {
+        guint acc = 0, wsum = 0;
+        for (gint k = -3; k <= 3; k++)
+          {
+            gint yy = (gint) y + k;
+            if (yy < 0 || yy >= (gint) h)
+              continue;
+            acc += kern[k + 3] * tmp[yy * w + x];
+            wsum += kern[k + 3];
+          }
+        data[y * w + x] = acc / wsum;
+      }
+}
